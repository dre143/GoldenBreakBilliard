rules_version = '2';

// Roles live in users/{uid}.role ("superadmin" | "owner" | "cashier" | "display"); users/{uid}.active gates
// access. A superadmin has every owner permission (isOwner() below is true for both) and is invisible to
// everyone else: only a superadmin can read, create, edit or deactivate a superadmin account. Superadmin
// accounts are first created in the Firebase console (Authentication user + users/{uid} document with role
// "superadmin"). A "display" account is for an unattended screen (e.g. a TV running Showcase) — it can sign
// in and read tables/cueSticks, nothing else; isWorkingStaff() below is isStaff() minus that role, and gates
// everything a display account shouldn't reach.
//
// Time integrity: session start/end times and sale times must equal request.time (the server clock),
// and every sale's table fee is recomputed here from those stamps. A device with a wrong or changed
// clock can't shorten a session, backdate a sale, or bill a different amount, and neither can a
// cashier calling the database directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function tablePath(id) { return /databases/$(database)/documents/tables/$(id); }
    function txPath(id) { return /databases/$(database)/documents/transactions/$(id); }
    function isStaff() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }
    // Owner-level access. True for a superadmin too, so a superadmin can do everything an owner can.
    function isOwner() { return isStaff() && get(userPath(request.auth.uid)).data.role in ['owner', 'superadmin']; }
    function isSuperadmin() { return isStaff() && get(userPath(request.auth.uid)).data.role == 'superadmin'; }
    // A "display" account (e.g. the TV/kiosk showing Showcase) is staff for sign-in purposes, but reads
    // only tables and cue sticks — nowhere with money, other staff's names, or any write access. Every
    // isStaff() below that guards something a display account shouldn't reach uses this instead.
    function isWorkingStaff() { return isStaff() && get(userPath(request.auth.uid)).data.role != 'display'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---- Official table rate (mirrors PRICING in js/billing.js) ----
    // First 60 minutes ₱200, plus a 5-minute grace: still ₱200 through 1:04:59. From 1:05:00 (3900000 ms) the
    // fee is ₱250, then +₱50 every 15 minutes (1:20:00, 1:35:00, ...): 200 + (1 + floor((ms - 3900000) / 900000)) * 50.
    // Returns the raw schedule fee for `ms` of billed time — not necessarily what's owed (see feeOk below).
    function rawFee(ms) {
      return ms < 3900000 ? 200 : 200 + (1 + math.floor((ms - 3900000) / 900000.0)) * 50;
    }
    // `fee` must be the schedule amount for `durationMs`, minus `alreadyPaid` (0 for an unpaid session —
    // see prepaidFeeOf below). This is what's actually owed, mirroring js/billing.js billSession/paidFee.
    function feeOk(fee, durationMs, alreadyPaid) {
      return durationMs is int && durationMs >= 0 && fee is int && fee == rawFee(durationMs) - alreadyPaid;
    }

    // Booked time: 0 (open time) or whole 15-minute steps.
    function bookingOk(ms) { return ms is int && ms >= 0 && ms % 900000 == 0; }

    // ---- Prepaid Set Hours bookings (mirrors the "prepaid" section of js/billing.js) ----
    // session.prepaid == null for a session that was never paid in advance (Open Time or an unpaid Set
    // Hours booking — Stop & Bill still works exactly as it always has). Otherwise it tracks how much of
    // the BOOKED time (session.plannedMs) has its fee already paid: { paidMs, lastTxId, refunded }.
    function prepaidMsOf(s) { return s.get('prepaid', null) == null ? 0 : s.prepaid.paidMs; }
    // ₱0 for a session that was never prepaid — NOT rawFee(0), which would wrongly read as "the first
    // hour is already paid". Only a real prepaid marker ever counts as money already collected.
    function prepaidFeeOf(s) { return s.get('prepaid', null) == null ? 0 : rawFee(s.prepaid.paidMs); }
    // Billed time floors at what's already been paid for (no refund for playing less than that — see
    // js/billing.js billSession); it never exceeds it either, since a booking auto-stops at plannedMs.
    function effectiveMs(s, durationMs) { return durationMs > prepaidMsOf(s) ? durationMs : prepaidMsOf(s); }

    // First-run marker: created atomically with the first owner profile.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'owner';
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Superadmin profiles are readable only by superadmins (and by the superadmin themself). Lists must
      // therefore filter with where('role', '!=', 'superadmin'), which the app does for everyone else.
      allow read: if signedIn()
        && (request.auth.uid == uid || isSuperadmin() || (isWorkingStaff() && resource.data.role != 'superadmin'));
      allow create: if isSuperadmin()
        || (isOwner() && request.resource.data.role != 'superadmin')
        || (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      // Owners manage cashier/owner accounts but can neither touch a superadmin nor make one; a superadmin
      // manages everyone. Everyone may update their own presence (server-stamped) only.
      allow update: if isSuperadmin()
        || (isOwner() && resource.data.role != 'superadmin' && request.resource.data.role != 'superadmin')
        || (request.auth.uid == uid && isStaff() && onlyChanges(['online', 'lastSeen'])
            && request.resource.data.lastSeen == request.time);
      allow delete: if false;
    }

    // Private server-clock probe used to show accurate timers on devices with a wrong clock.
    match /clock/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
    }

    // ---------------- tables & sessions ----------------
    // Allowed session changes (for owner and cashier alike):
    //   start  → available → in_use, startedAt = server time
    //   end    → clock stops once, endedAt = server time (no pause, no resume)
    //   edit   → items / rounds only; start and end times can never be edited
    //   cancel   → within the first 5 minutes only: the table fee becomes ₱0 (see cancelsGame)
    //   transfer → a live session moves to a different table, start time and all, in the same batch as
    //              that table freeing (see receivesTransfer/freesForTransfer)
    //   close    → in_use (ended) → available, only together with a matching new sale
    // Only an expired unpaid booking can continue with added time; completed sales stay final.

    function startsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['status', 'session', 'updatedAt'])
        && before.status == 'available' && before.session == null
        && after.status == 'in_use'
        && after.session.keys().hasOnly(['startedAt', 'ended', 'endedAt', 'plannedMs', 'items', 'rounds', 'openedBy', 'openedByName'])
        && after.session.startedAt == request.time
        && after.session.ended == false && after.session.endedAt == null
        && bookingOk(after.session.plannedMs)
        && after.session.items.size() == 0 && after.session.rounds == 0
        && after.session.openedBy == request.auth.uid;
    }

    function elapsedAt(s, end) {
      return s.get('elapsedBeforeResume', 0) + end.toMillis()
        - s.get('resumedAt', s.startedAt).toMillis();
    }

    function endedDuration(s) {
      let elapsed = elapsedAt(s, s.endedAt);
      return s.plannedMs > 0 && math.abs(elapsed - s.plannedMs) <= 2000 ? s.plannedMs : elapsed;
    }

    function endsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && before.session.ended == false
        && after.session.diff(before.session).affectedKeys().hasOnly(['ended', 'endedAt'])
        && after.session.ended == true
        && (after.session.endedAt == request.time
          || (before.session.plannedMs > 0
            && elapsedAt(before.session, request.time) >= before.session.plannedMs
            && elapsedAt(before.session, after.session.endedAt) == before.session.plannedMs));
    }

    // Extend an unpaid booking after it expired. Preserve its start, items and history.
    function extendsExpiredSession() {
      let before = resource.data;
      let after = request.resource.data;
      let s = before.session;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && s.ended == true && s.get('cancelled', null) == null
        && s.plannedMs > 0
        // Allow the same 2-second clock-sync tolerance as canExtendEndedSession().
        && elapsedAt(s, s.endedAt) >= s.plannedMs - 2000
        && after.session.diff(s).affectedKeys().hasOnly(['plannedMs', 'ended', 'endedAt', 'resumedAt', 'elapsedBeforeResume'])
        && bookingOk(after.session.plannedMs)
        && after.session.plannedMs > s.plannedMs
        && after.session.resumedAt == request.time
        && after.session.elapsedBeforeResume == endedDuration(s)
        && after.session.ended == false && after.session.endedAt == null;
    }

    function editsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && after.session.diff(before.session).affectedKeys().hasOnly(['items', 'rounds', 'plannedMs'])
        && after.session.items is list
        && after.session.rounds is int && after.session.rounds >= 0
        // Booked time can be extended, never reduced (it sets when overtime starts).
        && bookingOk(after.session.plannedMs)
        && after.session.plannedMs >= before.session.plannedMs;
    }

    // Pays some or all of a running Set Hours booking's table fee (js/services.js payBooking,
    // completeCheckout's payRunningBooking, and extendSession's payNow) without stopping the session:
    // status and ended are untouched, only session.prepaid (and, for "Add time → Pay now" or a combined
    // fee+items payment in the same write, plannedMs / items) change. Paying never ends the session —
    // only auto-stop reaching the booked time, or the cashier's own End Session, does that.
    function paysBooking() {
      let before = resource.data;
      let after = request.resource.data;
      let s = before.session;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && s.ended == false && s.get('cancelled', null) == null
        && s.plannedMs > 0
        && after.session.diff(s).affectedKeys().hasOnly(['prepaid', 'plannedMs', 'items'])
        // Items are either left exactly as they were, or cleared to [] because this same payment also
        // charged for them (payRunningBooking) — never rewritten to some other list.
        && (after.session.get('items', []) == s.get('items', []) || after.session.get('items', []).size() == 0)
        && bookingOk(after.session.plannedMs) && after.session.plannedMs >= s.plannedMs
        && paymentAppliedOk(s, after.session);
    }

    // Same as paysBooking(), but for "Add time → Pay now" on an EXPIRED prepaid booking: the write also
    // resumes the session, exactly like extendsExpiredSession() below, just with a payment folded in.
    function extendsExpiredSessionWithPayment() {
      let before = resource.data;
      let after = request.resource.data;
      let s = before.session;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && s.ended == true && s.get('cancelled', null) == null
        && s.plannedMs > 0
        && elapsedAt(s, s.endedAt) >= s.plannedMs - 2000
        && after.session.diff(s).affectedKeys().hasOnly(['plannedMs', 'ended', 'endedAt', 'resumedAt', 'elapsedBeforeResume', 'prepaid'])
        && bookingOk(after.session.plannedMs) && after.session.plannedMs > s.plannedMs
        && after.session.resumedAt == request.time
        && after.session.elapsedBeforeResume == endedDuration(s)
        && after.session.ended == false && after.session.endedAt == null
        && paymentAppliedOk(s, after.session);
    }

    // A payment write brings session.prepaid.paidMs level with the (possibly just-grown) plannedMs,
    // either by linking a brand-new "prepay" transaction (see prepaySaleOk below — money actually
    // changed hands) or, when the extra booked time lands in a bracket that's already paid for, with no
    // linked transaction at all, since nothing new is owed (js/services.js bookingPaymentWrite).
    function paymentAppliedOk(s, afterSession) {
      let prevFee = prepaidFeeOf(s);
      let p = afterSession.prepaid;
      return p.keys().hasOnly(['paidMs', 'lastTxId', 'refunded'])
        && p.paidMs == afterSession.plannedMs
        && p.get('refunded', false) == s.get('prepaid', {}).get('refunded', false)
        && (
          (rawFee(p.paidMs) == prevFee && p.lastTxId == s.get('prepaid', {}).get('lastTxId', null))
          || (rawFee(p.paidMs) > prevFee
            && p.lastTxId is string
            && !exists(txPath(p.lastTxId)) && existsAfter(txPath(p.lastTxId))));
    }

    // Cancel game: within the first 5 minutes (CANCEL_WINDOW_MS in js/billing.js), measured on server
    // time, the table fee becomes ₱0. Either the running clock stops in this same write, or a clock
    // that was already stopped ran 5 minutes or less. Allowed once; items stay on the bill.
    //
    // If the booking was already prepaid, cancelling also refunds it in the same write — a linked
    // append-only "refund" transaction (see refundOk/refundSaleOk) — since the money was already taken
    // and transactions can never be edited or deleted.
    function cancelsGame() {
      let before = resource.data;
      let after = request.resource.data;
      let c = after.session.cancelled;
      let s = before.session;
      let refunding = prepaidFeeOf(s) > 0 && s.prepaid.get('refunded', false) == false;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && s.get('cancelled', null) == null
        && c.keys().hasOnly(['reason', 'note', 'byId', 'byName', 'at'])
        && c.reason is string && c.reason.size() > 0 && c.reason.size() <= 80
        && c.note is string && c.note.size() <= 140
        && c.byId == request.auth.uid
        && c.at == request.time
        && (refunding ? refundOk(s, after.session) : true)
        && (
          (s.ended == false
            && after.session.diff(s).affectedKeys().hasOnly(refunding ? ['ended', 'endedAt', 'cancelled', 'prepaid'] : ['ended', 'endedAt', 'cancelled'])
            && after.session.ended == true
            && after.session.endedAt == request.time
            && request.time <= s.startedAt + duration.value(300, 's'))
          || (s.ended == true
            && after.session.diff(s).affectedKeys().hasOnly(refunding ? ['cancelled', 'prepaid'] : ['cancelled'])
            && s.endedAt.toMillis() - s.startedAt.toMillis() <= 300000)
        );
    }

    // The refund half of cancelsGame() above: paidMs/lastTxId are untouched (the original payment
    // stands, just refunded), refunded flips true exactly once, and refundTxId points to a real,
    // matching "refund" transaction created in the same batch (see refundSaleOk on transactions/{id}).
    function refundOk(s, afterSession) {
      let prev = s.prepaid;
      let p = afterSession.prepaid;
      let sale = getAfter(txPath(p.get('refundTxId', ''))).data;
      return p.keys().hasOnly(['paidMs', 'lastTxId', 'refunded', 'refundTxId'])
        && p.paidMs == prev.paidMs && p.lastTxId == prev.lastTxId
        && p.refunded == true && p.refundTxId is string
        && !exists(txPath(p.refundTxId)) && existsAfter(txPath(p.refundTxId))
        && sale.get('kind', null) == 'refund'
        && sale.tableFee == -rawFee(prev.paidMs)
        && math.abs(sale.total - sale.tableFee) < 0.005;
    }

    // Transfer table: a live (unended) session moves to a different table, keeping its original start
    // time, items, rounds and booking length untouched — the bill continues without interruption. Both
    // table writes happen in the same batch. `session.transfers` grows by exactly one entry, recording
    // where it came from, when, and who moved it. An ended session (clock stopped, awaiting payment)
    // can't be transferred, only checked out — there is still no "reopen" of a session once it's ended.
    //
    // Each side is verified independently, cross-checking the other document's before/after state — the
    // same two-sided pattern closesWithSale()/saleMatchesSession() use for checkout, so neither write is
    // valid alone: a live session can't be discarded by writing only the source-clearing half, and a
    // table can't receive an invented session without a real, matching source.
    //
    // transfers[].at is a client-timestamp (js/services.js), not request.time: Firestore doesn't allow a
    // serverTimestamp() sentinel inside an array element, and `transfers` is one. It's a display-only
    // note (when the move happened, for the receipt), never billing — the bill still runs purely off
    // session.startedAt/endedAt, real server timestamps, untouched by any of this. So it only needs a
    // sanity bound around the write's real server time, not an exact match.
    //
    // Kept deliberately lean: no .keys().hasOnly() structural checks (map-key iteration is expensive
    // enough here to hit Firestore's 1000-expression-per-request ceiling once combined with the
    // get()/getAfter() cross-reads both functions need), and freesForTransfer() doesn't re-derive
    // startedAt — receivesTransfer() already ties it to the exact same source document.
    function receivesTransfer(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let list = after.session.transfers;
      let last = list[list.size() - 1];
      let from = get(tablePath(last.fromTableId)).data;
      let fromAfter = getAfter(tablePath(last.fromTableId)).data;
      let s = from.session;
      let nowMs = request.time.toMillis();
      return onlyChanges(['status', 'session', 'updatedAt'])
        && before.status == 'available' && before.session == null
        && after.status == 'in_use'
        && last.fromTableId != tableId
        && from.status == 'in_use' && s != null && s.ended == false
        && fromAfter.status == 'available' && fromAfter.session == null
        && fromAfter.lastTransferToId == tableId
        && after.session.startedAt.toMillis() == s.startedAt.toMillis()
        && after.session.ended == false && after.session.endedAt == null
        && after.session.plannedMs == s.plannedMs
        && after.session.get('resumedAt', null) == s.get('resumedAt', null)
        && after.session.get('elapsedBeforeResume', 0) == s.get('elapsedBeforeResume', 0)
        // A prepaid marker (js/billing.js paidMs) travels with the game, unchanged, same as its start time.
        && after.session.get('prepaid', null) == s.get('prepaid', null)
        && after.session.items == s.items
        && after.session.rounds == s.rounds
        && after.session.openedBy == s.openedBy && after.session.openedByName == s.openedByName
        // Exactly one new entry appended (list + list concatenation isn't a supported rules operation).
        && list.size() == s.get('transfers', []).size() + 1
        && last.fromTableName == from.name
        && last.at is timestamp && last.at.toMillis() >= nowMs - 300000 && last.at.toMillis() <= nowMs + 300000
        && last.byId == request.auth.uid;
    }

    function freesForTransfer(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let dest = getAfter(tablePath(after.lastTransferToId)).data;
      let n = dest.session.transfers.size();
      return onlyChanges(['status', 'session', 'lastTransferToId', 'updatedAt'])
        && before.status == 'in_use' && before.session != null && before.session.ended == false
        && after.status == 'available' && after.session == null
        && after.lastTransferToId != tableId
        && dest.status == 'in_use' && dest.session != null
        && n > 0 && dest.session.transfers[n - 1].fromTableId == tableId;
    }

    function closesWithSale(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let sale = getAfter(txPath(after.lastTxId)).data;
      return onlyChanges(['status', 'session', 'lastTxId', 'updatedAt'])
        && before.status == 'in_use' && before.session != null && before.session.ended == true
        && after.status == 'available' && after.session == null
        && !exists(txPath(after.lastTxId))
        && existsAfter(txPath(after.lastTxId))
        && sale.tableId == tableId
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis();
    }

    match /tables/{tableId} {
      allow read: if isStaff();
      allow create: if isOwner()
        && request.resource.data.status == 'available' && request.resource.data.session == null;
      allow delete: if isOwner() && resource.data.status == 'available';
      allow update: if isWorkingStaff()
        && request.resource.data.status in ['available', 'in_use']
        && ((isOwner() && onlyChanges(['name', 'number', 'light', 'updatedAt']))
            || onlyChanges(['light', 'updatedAt'])
            || startsSession()
            || endsSession()
            || extendsExpiredSession()
            || extendsExpiredSessionWithPayment()
            || paysBooking()
            || cancelsGame()
            || editsSession()
            || closesWithSale(tableId)
            // Cheap guards before the expensive cross-document reads inside these two: a rules function's
            // own `let` bindings run as soon as it's called, not lazily by first use, so calling either one
            // on the write it can't possibly match (e.g. receivesTransfer() against the SOURCE table's own
            // clearing write) still pays for its get()/getAfter() calls before failing. Checking the shape
            // of this write first means only the branch that could plausibly apply ever calls in.
            || (resource.data.status == 'available' && request.resource.data.status == 'in_use' && receivesTransfer(tableId))
            || (resource.data.status == 'in_use' && request.resource.data.status == 'available' && freesForTransfer(tableId)));
    }

    match /products/{productId} {
      allow read: if isWorkingStaff();
      allow create, delete: if isOwner();
      // Cashiers may only decrement stock (checkout deduction). Voiding a sale never returns stock —
      // items stay sold — so there is no path for a cashier to raise it back up.
      allow update: if isOwner()
        || (isWorkingStaff()
            && onlyChanges(['stock', 'updatedAt'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    match /restocks/{id} {
      allow read: if isWorkingStaff();
      allow create: if isOwner() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------- cue sticks ----------------
    // A separate catalog from products: each cue stick is a unique physical item, not counted stock,
    // so a sale flips status available -> sold instead of decrementing a quantity. The photo, if any,
    // is a compressed image kept right on the document (no separate file storage in this app).
    match /cueSticks/{id} {
      allow read: if isStaff();
      allow create: if isOwner()
        && (request.resource.data.get('photo', null) == null || request.resource.data.photo.size() < 900000);
      allow delete: if isOwner();
      // Cashiers may only mark an available cue sold at sale time, server-timestamped, one-way — the
      // same shape as a product's stock only ever decreasing for a cashier.
      allow update: if (isOwner()
            && (request.resource.data.get('photo', null) == null || request.resource.data.photo.size() < 900000))
        || (isWorkingStaff()
            && onlyChanges(['status', 'soldAt', 'soldTxId', 'soldByName', 'updatedAt'])
            && resource.data.status == 'available'
            && request.resource.data.status == 'sold'
            && request.resource.data.soldAt == request.time);
    }

    // ---------------- transactions ----------------
    // Append-only ledger. A sale can only be created for a table whose clock was stopped by the server,
    // with the table fee recomputed from that session's server stamps, in the same write that frees the table.
    // A Quick Sale (walk-in, no table) instead just has to add up: no table fee, total == productTotal.
    function quickSaleOk(sale) {
      return sale.tableId == null
        && sale.tableFee == 0
        && sale.items is list
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - sale.productTotal) < 0.005;
    }

    // A cue stick sale: no table fee, no products — the total is entirely cueStickTotal. The cues
    // themselves are independently marked 'sold' (see /cueSticks above), not cross-checked here, the
    // same trust level a Quick Sale's product-stock deduction already gets.
    function cueStickSaleOk(sale) {
      return sale.tableId == null
        && sale.get('saleType', null) == 'cue-stick'
        && sale.tableFee == 0
        && sale.get('productTotal', 0) == 0
        && sale.items is list
        && sale.cueStickTotal is number && sale.cueStickTotal >= 0
        && math.abs(sale.total - sale.cueStickTotal) < 0.005;
    }

    // A normal (non-prepay, non-refund) sale, at checkout: billed on the time actually played, floored
    // at whatever was already prepaid so it's never charged twice and never refunded for playing less
    // than what was paid for (js/billing.js billSession) — a cancelled game within 5 minutes still has
    // no table fee of its own, but see refundSaleOk for money already taken on it.
    function saleMatchesSession(sale, id) {
      let before = get(tablePath(sale.tableId)).data;
      let after = getAfter(tablePath(sale.tableId)).data;
      let s = before.session;
      let billedMs = effectiveMs(s, sale.durationMs);
      return before.status == 'in_use' && before.session != null
        && before.session.ended == true && before.session.endedAt is timestamp
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis()
        && sale.durationMs == endedDuration(before.session)
        && sale.plannedMs == before.session.plannedMs
        // A normal sale is billed at the rate; a game cancelled within 5 minutes has no table fee.
        && ((before.session.get('cancelled', null) == null
              && sale.get('gameCancelled', false) == false
              && sale.billedMs == billedMs
              && feeOk(sale.tableFee, billedMs, prepaidFeeOf(s)))
            || (before.session.get('cancelled', null) != null
              && sale.gameCancelled == true
              && sale.durationMs <= 300000
              && sale.billedMs == sale.durationMs
              && sale.tableFee == 0))
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - (sale.tableFee + sale.productTotal)) < 0.005
        && after.status == 'available' && after.session == null && after.lastTxId == id;
    }

    // A payment on a running Set Hours booking, no clock stopped (js/services.js payBooking,
    // completeCheckout's payRunningBooking, extendSession's payNow): the fee for newly-paid booked
    // time, from the same schedule as any other sale, cross-checked against the table's own before/
    // after prepaid state. It may also include items — completeCheckout's single "Complete Transaction"
    // now settles the table-fee balance and whatever's on the bill together without ending the session
    // — but only when the same write clears them from the table (never left to be double-charged later).
    function prepaySaleOk(sale, id) {
      let before = get(tablePath(sale.tableId)).data;
      let after = getAfter(tablePath(sale.tableId)).data;
      let s = before.session;
      let newPaidMs = after.session.prepaid.paidMs;
      return before.status == 'in_use' && s != null && s.ended == false && s.get('cancelled', null) == null
        && s.plannedMs > 0
        && sale.startedAt.toMillis() == s.startedAt.toMillis()
        && sale.plannedMs == newPaidMs
        && sale.items is list
        && sale.productTotal is number && sale.productTotal >= 0
        && sale.tableFee == rawFee(newPaidMs) - prepaidFeeOf(s)
        && sale.tableFee >= 0
        && math.abs(sale.total - (sale.tableFee + sale.productTotal)) < 0.005
        && sale.total > 0
        && (sale.items.size() == 0 || after.session.get('items', []).size() == 0)
        && after.status == 'in_use'
        && after.session.prepaid.paidMs == newPaidMs
        && after.session.prepaid.lastTxId == id;
    }

    // The refund half of cancelGame() on a prepaid booking: a negative, append-only sale for exactly
    // what was paid on the booking, cross-checked against the table's cancelsGame()/refundOk() write.
    function refundSaleOk(sale) {
      let before = get(tablePath(sale.tableId)).data;
      let s = before.session;
      return s != null && prepaidFeeOf(s) > 0 && s.prepaid.get('refunded', false) == false
        && sale.method in ['cash', 'gcash']
        && sale.get('gameCancelled', false) == true
        && sale.items.size() == 0 && sale.productTotal == 0
        && math.abs(sale.tableFee + prepaidFeeOf(s)) < 0.005
        && math.abs(sale.total - sale.tableFee) < 0.005
        && sale.get('refundOfTxId', null) == s.prepaid.lastTxId;
    }

    match /transactions/{id} {
      allow read: if isWorkingStaff();
      // Nothing to pay (a cancelled game with no items) is recorded as method 'none'.
      allow create: if isWorkingStaff()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.get('kind', null) == 'prepay'
            && request.resource.data.tableId != null
            && request.resource.data.method in ['cash', 'gcash', 'split']
            && (!(request.resource.data.method in ['gcash', 'split'])
                || (request.resource.data.get('gcashRef', null) is string
                    && request.resource.data.gcashRef.matches('^[0-9]{5}$')))
            && prepaySaleOk(request.resource.data, id))
          || (request.resource.data.get('kind', null) == 'refund'
              && request.resource.data.tableId != null
              && refundSaleOk(request.resource.data))
          || (request.resource.data.get('kind', null) != 'prepay' && request.resource.data.get('kind', null) != 'refund'
              && (request.resource.data.method in ['cash', 'gcash', 'split']
                  || (request.resource.data.method == 'none' && request.resource.data.total == 0))
              // Any QRPH part needs the last 5 digits of the QRPH reference number.
              && (!(request.resource.data.method in ['gcash', 'split'])
                  || (request.resource.data.get('gcashRef', null) is string
                      && request.resource.data.gcashRef.matches('^[0-9]{5}$')))
              && ((request.resource.data.tableId == null
                    && (quickSaleOk(request.resource.data) || cueStickSaleOk(request.resource.data)))
                  || (request.resource.data.tableId != null && saleMatchesSession(request.resource.data, id))))
        );
      // The ledger is append-only. A game is cancelled on the table before payment (cancelsGame),
      // never by changing a completed sale.
      allow update, delete: if false;
    }
    // Hall-wide settings (e.g. settings/shifts: whether the hall runs one shift or Day + Night).
    match /settings/{id} {
      allow read: if isWorkingStaff();
      allow write: if isOwner();
    }

    // ---------------- expenses ----------------
    // Cash taken from the drawer. Any staff member logs expenses under their own name, stamped with
    // server time so each one lands on the shift that was actually on duty. Nobody can edit a logged
    // expense. Only the owner can remove a mistaken one, so the shift report stays an audit trail.
    match /expenses/{id} {
      allow read: if isWorkingStaff();
      allow create: if isWorkingStaff()
        && request.resource.data.keys().hasOnly(['description', 'amount', 'cashierId', 'cashierName', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.cashierName is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
