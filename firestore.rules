rules_version = '2';

// Roles live in users/{uid}.role ("superadmin" | "owner" | "cashier"); users/{uid}.active gates access.
// A superadmin has every owner permission (isOwner() below is true for both) and is invisible to everyone
// else: only a superadmin can read, create, edit or deactivate a superadmin account. Superadmin accounts are
// first created in the Firebase console (Authentication user + users/{uid} document with role "superadmin").
//
// Time integrity: session start/end times and sale times must equal request.time (the server clock),
// and every sale's table fee is recomputed here from those stamps. A device with a wrong or changed
// clock can't shorten a session, backdate a sale, or bill a different amount, and neither can a
// cashier calling the database directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function tablePath(id) { return /databases/$(database)/documents/tables/$(id); }
    function txPath(id) { return /databases/$(database)/documents/transactions/$(id); }
    function isStaff() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }
    // Owner-level access. True for a superadmin too, so a superadmin can do everything an owner can.
    function isOwner() { return isStaff() && get(userPath(request.auth.uid)).data.role in ['owner', 'superadmin']; }
    function isSuperadmin() { return isStaff() && get(userPath(request.auth.uid)).data.role == 'superadmin'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---- Official table rate (mirrors PRICING in js/billing.js) ----
    // First 60 minutes ₱200, plus a 5-minute grace: still ₱200 through 1:05:59. From 1:06:00 (3960000 ms) the
    // fee is ₱250, then +₱50 every 15 minutes (1:21:00, 1:36:00, ...): 200 + (1 + floor((ms - 3960000) / 900000)) * 50.
    function feeOk(fee, durationMs) {
      return durationMs is int && durationMs >= 0 && fee is int
        && ((durationMs < 3960000 && fee == 200)
            || (durationMs >= 3960000 && fee == 200 + (1 + math.floor((durationMs - 3960000) / 900000.0)) * 50));
    }

    // Booked time: 0 (open time) or whole 15-minute steps.
    function bookingOk(ms) { return ms is int && ms >= 0 && ms % 900000 == 0; }

    // Billed time is the time actually played, never the booked time (unused booked time is not charged).
    function billedOk(billedMs, durationMs) {
      return billedMs is int && billedMs == durationMs;
    }

    // First-run marker: created atomically with the first owner profile.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'owner';
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Superadmin profiles are readable only by superadmins (and by the superadmin themself). Lists must
      // therefore filter with where('role', '!=', 'superadmin'), which the app does for everyone else.
      allow read: if signedIn()
        && (request.auth.uid == uid || isSuperadmin() || (isStaff() && resource.data.role != 'superadmin'));
      allow create: if isSuperadmin()
        || (isOwner() && request.resource.data.role != 'superadmin')
        || (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      // Owners manage cashier/owner accounts but can neither touch a superadmin nor make one; a superadmin
      // manages everyone. Everyone may update their own presence (server-stamped) only.
      allow update: if isSuperadmin()
        || (isOwner() && resource.data.role != 'superadmin' && request.resource.data.role != 'superadmin')
        || (request.auth.uid == uid && isStaff() && onlyChanges(['online', 'lastSeen'])
            && request.resource.data.lastSeen == request.time);
      allow delete: if false;
    }

    // Private server-clock probe used to show accurate timers on devices with a wrong clock.
    match /clock/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
    }

    // ---------------- tables & sessions ----------------
    // Allowed session changes (for owner and cashier alike):
    //   start  → available → in_use, startedAt = server time
    //   end    → clock stops once, endedAt = server time (no pause, no resume)
    //   edit   → items / rounds only; start and end times can never be edited
    //   cancel   → within the first 5 minutes only: the table fee becomes ₱0 (see cancelsGame)
    //   transfer → a live session moves to a different table, start time and all, in the same batch as
    //              that table freeing (see receivesTransfer/freesForTransfer)
    //   close    → in_use (ended) → available, only together with a matching new sale
    // There is no "reopen", and a completed sale can never be changed, so a table freed at checkout stays freed.

    function startsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['status', 'session', 'updatedAt'])
        && before.status == 'available' && before.session == null
        && after.status == 'in_use'
        && after.session.keys().hasOnly(['startedAt', 'ended', 'endedAt', 'plannedMs', 'items', 'rounds', 'openedBy', 'openedByName'])
        && after.session.startedAt == request.time
        && after.session.ended == false && after.session.endedAt == null
        && bookingOk(after.session.plannedMs)
        && after.session.items.size() == 0 && after.session.rounds == 0
        && after.session.openedBy == request.auth.uid;
    }

    function endsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && before.session.ended == false
        && after.session.diff(before.session).affectedKeys().hasOnly(['ended', 'endedAt'])
        && after.session.ended == true
        && after.session.endedAt == request.time;
    }

    function editsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && after.session.diff(before.session).affectedKeys().hasOnly(['items', 'rounds', 'plannedMs'])
        && after.session.items is list
        && after.session.rounds is int && after.session.rounds >= 0
        // Booked time can be extended, never reduced (it sets when overtime starts).
        && bookingOk(after.session.plannedMs)
        && after.session.plannedMs >= before.session.plannedMs;
    }

    // Cancel game: within the first 5 minutes (CANCEL_WINDOW_MS in js/billing.js), measured on server
    // time, the table fee becomes ₱0. Either the running clock stops in this same write, or a clock
    // that was already stopped ran 5 minutes or less. Allowed once; items stay on the bill.
    function cancelsGame() {
      let before = resource.data;
      let after = request.resource.data;
      let c = after.session.cancelled;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && before.session.get('cancelled', null) == null
        && c.keys().hasOnly(['reason', 'note', 'byId', 'byName', 'at'])
        && c.reason is string && c.reason.size() > 0 && c.reason.size() <= 80
        && c.note is string && c.note.size() <= 140
        && c.byId == request.auth.uid
        && c.at == request.time
        && (
          (before.session.ended == false
            && after.session.diff(before.session).affectedKeys().hasOnly(['ended', 'endedAt', 'cancelled'])
            && after.session.ended == true
            && after.session.endedAt == request.time
            && request.time <= before.session.startedAt + duration.value(300, 's'))
          || (before.session.ended == true
            && after.session.diff(before.session).affectedKeys().hasOnly(['cancelled'])
            && before.session.endedAt.toMillis() - before.session.startedAt.toMillis() <= 300000)
        );
    }

    // Transfer table: a live (unended) session moves to a different table, keeping its original start
    // time, items, rounds and booking length untouched — the bill continues without interruption. Both
    // table writes happen in the same batch. `session.transfers` grows by exactly one entry, recording
    // where it came from, when, and who moved it. An ended session (clock stopped, awaiting payment)
    // can't be transferred, only checked out — there is still no "reopen" of a session once it's ended.
    //
    // Each side is verified independently, cross-checking the other document's before/after state — the
    // same two-sided pattern closesWithSale()/saleMatchesSession() use for checkout, so neither write is
    // valid alone: a live session can't be discarded by writing only the source-clearing half, and a
    // table can't receive an invented session without a real, matching source.
    //
    // transfers[].at is a client-timestamp (js/services.js), not request.time: Firestore doesn't allow a
    // serverTimestamp() sentinel inside an array element, and `transfers` is one. It's a display-only
    // note (when the move happened, for the receipt), never billing — the bill still runs purely off
    // session.startedAt/endedAt, real server timestamps, untouched by any of this. So it only needs a
    // sanity bound around the write's real server time, not an exact match.
    //
    // Kept deliberately lean: no .keys().hasOnly() structural checks (map-key iteration is expensive
    // enough here to hit Firestore's 1000-expression-per-request ceiling once combined with the
    // get()/getAfter() cross-reads both functions need), and freesForTransfer() doesn't re-derive
    // startedAt — receivesTransfer() already ties it to the exact same source document.
    function receivesTransfer(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let list = after.session.transfers;
      let last = list[list.size() - 1];
      let from = get(tablePath(last.fromTableId)).data;
      let fromAfter = getAfter(tablePath(last.fromTableId)).data;
      let s = from.session;
      let nowMs = request.time.toMillis();
      return onlyChanges(['status', 'session', 'updatedAt'])
        && before.status == 'available' && before.session == null
        && after.status == 'in_use'
        && last.fromTableId != tableId
        && from.status == 'in_use' && s != null && s.ended == false
        && fromAfter.status == 'available' && fromAfter.session == null
        && fromAfter.lastTransferToId == tableId
        && after.session.startedAt.toMillis() == s.startedAt.toMillis()
        && after.session.ended == false && after.session.endedAt == null
        && after.session.plannedMs == s.plannedMs
        && after.session.items == s.items
        && after.session.rounds == s.rounds
        && after.session.openedBy == s.openedBy && after.session.openedByName == s.openedByName
        // Exactly one new entry appended (list + list concatenation isn't a supported rules operation).
        && list.size() == s.get('transfers', []).size() + 1
        && last.fromTableName == from.name
        && last.at is timestamp && last.at.toMillis() >= nowMs - 300000 && last.at.toMillis() <= nowMs + 300000
        && last.byId == request.auth.uid;
    }

    function freesForTransfer(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let dest = getAfter(tablePath(after.lastTransferToId)).data;
      let n = dest.session.transfers.size();
      return onlyChanges(['status', 'session', 'lastTransferToId', 'updatedAt'])
        && before.status == 'in_use' && before.session != null && before.session.ended == false
        && after.status == 'available' && after.session == null
        && after.lastTransferToId != tableId
        && dest.status == 'in_use' && dest.session != null
        && n > 0 && dest.session.transfers[n - 1].fromTableId == tableId;
    }

    function closesWithSale(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let sale = getAfter(txPath(after.lastTxId)).data;
      return onlyChanges(['status', 'session', 'lastTxId', 'updatedAt'])
        && before.status == 'in_use' && before.session != null && before.session.ended == true
        && after.status == 'available' && after.session == null
        && !exists(txPath(after.lastTxId))
        && existsAfter(txPath(after.lastTxId))
        && sale.tableId == tableId
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis();
    }

    match /tables/{tableId} {
      allow read: if isStaff();
      allow create: if isOwner()
        && request.resource.data.status == 'available' && request.resource.data.session == null;
      allow delete: if isOwner() && resource.data.status == 'available';
      allow update: if isStaff()
        && request.resource.data.status in ['available', 'in_use']
        && ((isOwner() && onlyChanges(['name', 'number', 'light', 'updatedAt']))
            || onlyChanges(['light', 'updatedAt'])
            || startsSession()
            || endsSession()
            || cancelsGame()
            || editsSession()
            || closesWithSale(tableId)
            // Cheap guards before the expensive cross-document reads inside these two: a rules function's
            // own `let` bindings run as soon as it's called, not lazily by first use, so calling either one
            // on the write it can't possibly match (e.g. receivesTransfer() against the SOURCE table's own
            // clearing write) still pays for its get()/getAfter() calls before failing. Checking the shape
            // of this write first means only the branch that could plausibly apply ever calls in.
            || (resource.data.status == 'available' && request.resource.data.status == 'in_use' && receivesTransfer(tableId))
            || (resource.data.status == 'in_use' && request.resource.data.status == 'available' && freesForTransfer(tableId)));
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      // Cashiers may only decrement stock (checkout deduction). Voiding a sale never returns stock —
      // items stay sold — so there is no path for a cashier to raise it back up.
      allow update: if isOwner()
        || (isStaff()
            && onlyChanges(['stock', 'updatedAt'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    match /restocks/{id} {
      allow read: if isStaff();
      allow create: if isOwner() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------- transactions ----------------
    // Append-only ledger. A sale can only be created for a table whose clock was stopped by the server,
    // with the table fee recomputed from that session's server stamps, in the same write that frees the table.
    // A Quick Sale (walk-in, no table) instead just has to add up: no table fee, total == productTotal.
    function quickSaleOk(sale) {
      return sale.tableId == null
        && sale.tableFee == 0
        && sale.items is list
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - sale.productTotal) < 0.005;
    }

    function saleMatchesSession(sale, id) {
      let before = get(tablePath(sale.tableId)).data;
      let after = getAfter(tablePath(sale.tableId)).data;
      return before.status == 'in_use' && before.session != null
        && before.session.ended == true && before.session.endedAt is timestamp
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis()
        && sale.durationMs == before.session.endedAt.toMillis() - before.session.startedAt.toMillis()
        && sale.plannedMs == before.session.plannedMs
        // A normal sale is billed at the rate; a game cancelled within 5 minutes has no table fee.
        && ((before.session.get('cancelled', null) == null
              && sale.get('gameCancelled', false) == false
              && billedOk(sale.billedMs, sale.durationMs)
              && feeOk(sale.tableFee, sale.billedMs))
            || (before.session.get('cancelled', null) != null
              && sale.gameCancelled == true
              && sale.durationMs <= 300000
              && sale.billedMs == sale.durationMs
              && sale.tableFee == 0))
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - (sale.tableFee + sale.productTotal)) < 0.005
        && after.status == 'available' && after.session == null && after.lastTxId == id;
    }

    match /transactions/{id} {
      allow read: if isStaff();
      // Nothing to pay (a cancelled game with no items) is recorded as method 'none'.
      allow create: if isStaff()
        && request.resource.data.cashierId == request.auth.uid
        && (request.resource.data.method in ['cash', 'gcash', 'split']
            || (request.resource.data.method == 'none' && request.resource.data.total == 0))
        // Any GCash part needs the last 5 digits of the GCash reference number.
        && (!(request.resource.data.method in ['gcash', 'split'])
            || (request.resource.data.get('gcashRef', null) is string
                && request.resource.data.gcashRef.matches('^[0-9]{5}$')))
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.tableId == null && quickSaleOk(request.resource.data))
            || (request.resource.data.tableId != null && saleMatchesSession(request.resource.data, id)));
      // The ledger is append-only. A game is cancelled on the table before payment (cancelsGame),
      // never by changing a completed sale.
      allow update, delete: if false;
    }
    // Hall-wide settings (e.g. settings/shifts: whether the hall runs one shift or Day + Night).
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ---------------- expenses ----------------
    // Cash taken from the drawer. Any staff member logs expenses under their own name, stamped with
    // server time so each one lands on the shift that was actually on duty. Nobody can edit a logged
    // expense. Only the owner can remove a mistaken one, so the shift report stays an audit trail.
    match /expenses/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['description', 'amount', 'cashierId', 'cashierName', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.cashierName is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
