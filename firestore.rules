rules_version = '2';

// Roles live in users/{uid}.role ("owner" | "cashier"); users/{uid}.active gates access.
//
// Time integrity: session start/end times and sale times must equal request.time (the server clock),
// and every sale's table fee is recomputed here from those stamps. A device with a wrong or changed
// clock can't shorten a session, backdate a sale, or bill a different amount, and neither can a
// cashier calling the database directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function tablePath(id) { return /databases/$(database)/documents/tables/$(id); }
    function txPath(id) { return /databases/$(database)/documents/transactions/$(id); }
    function isStaff() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }
    function isOwner() { return isStaff() && get(userPath(request.auth.uid)).data.role == 'owner'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---- Official table rate (mirrors PRICING in js/billing.js) ----
    // First 60 minutes ₱200; each started 15-minute bracket after that ₱50, always rounded up.
    function feeOk(fee, durationMs) {
      return durationMs is int && durationMs >= 0 && fee is int
        && ((durationMs <= 3600000 && fee == 200)
            || (durationMs > 3600000 && fee == 200 + math.ceil((durationMs - 3600000) / 900000.0) * 50));
    }

    // Booked time: 0 (open time) or whole 15-minute steps.
    function bookingOk(ms) { return ms is int && ms >= 0 && ms % 900000 == 0; }

    // Billed time is whichever is longer, booked or actually played (no ternary in rules).
    function billedOk(billedMs, durationMs, plannedMs) {
      return billedMs is int
        && billedMs >= durationMs && billedMs >= plannedMs
        && (billedMs == durationMs || billedMs == plannedMs);
    }

    // First-run marker: created atomically with the first owner profile.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'owner';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if isOwner()
        || (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      // Owners manage accounts; everyone may update their own presence (server-stamped) only.
      allow update: if isOwner()
        || (request.auth.uid == uid && isStaff() && onlyChanges(['online', 'lastSeen'])
            && request.resource.data.lastSeen == request.time);
      allow delete: if false;
    }

    // Private server-clock probe used to show accurate timers on devices with a wrong clock.
    match /clock/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
    }

    // ---------------- tables & sessions ----------------
    // Allowed session changes (for owner and cashier alike):
    //   start  → available → in_use, startedAt = server time
    //   end    → clock stops once, endedAt = server time (no pause, no resume)
    //   edit   → items / rounds only; start and end times can never be edited
    //   close  → in_use (ended) → available, only together with a matching new sale
    // There is no "reopen": voiding a sale only waives its table fee (see transactions below) and
    // never touches the table, so a table freed at checkout stays freed.

    function startsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['status', 'session', 'updatedAt'])
        && before.status == 'available' && before.session == null
        && after.status == 'in_use'
        && after.session.keys().hasOnly(['startedAt', 'ended', 'endedAt', 'plannedMs', 'items', 'rounds', 'openedBy', 'openedByName'])
        && after.session.startedAt == request.time
        && after.session.ended == false && after.session.endedAt == null
        && bookingOk(after.session.plannedMs)
        && after.session.items.size() == 0 && after.session.rounds == 0
        && after.session.openedBy == request.auth.uid;
    }

    function endsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && before.session.ended == false
        && after.session.diff(before.session).affectedKeys().hasOnly(['ended', 'endedAt'])
        && after.session.ended == true
        && after.session.endedAt == request.time;
    }

    function editsSession() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['session', 'updatedAt'])
        && before.status == 'in_use' && after.status == 'in_use'
        && after.session.diff(before.session).affectedKeys().hasOnly(['items', 'rounds', 'plannedMs'])
        && after.session.items is list
        && after.session.rounds is int && after.session.rounds >= 0
        // Booked time can be extended, never reduced (that would cut the minimum charge).
        && bookingOk(after.session.plannedMs)
        && after.session.plannedMs >= before.session.plannedMs;
    }

    function closesWithSale(tableId) {
      let before = resource.data;
      let after = request.resource.data;
      let sale = getAfter(txPath(after.lastTxId)).data;
      return onlyChanges(['status', 'session', 'lastTxId', 'updatedAt'])
        && before.status == 'in_use' && before.session != null && before.session.ended == true
        && after.status == 'available' && after.session == null
        && !exists(txPath(after.lastTxId))
        && existsAfter(txPath(after.lastTxId))
        && sale.tableId == tableId
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis();
    }

    match /tables/{tableId} {
      allow read: if isStaff();
      allow create: if isOwner()
        && request.resource.data.status == 'available' && request.resource.data.session == null;
      allow delete: if isOwner() && resource.data.status == 'available';
      allow update: if isStaff()
        && request.resource.data.status in ['available', 'in_use']
        && ((isOwner() && onlyChanges(['name', 'number', 'light', 'updatedAt']))
            || onlyChanges(['light', 'updatedAt'])
            || startsSession()
            || endsSession()
            || editsSession()
            || closesWithSale(tableId));
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      // Cashiers may only decrement stock (checkout deduction). Voiding a sale never returns stock —
      // items stay sold — so there is no path for a cashier to raise it back up.
      allow update: if isOwner()
        || (isStaff()
            && onlyChanges(['stock', 'updatedAt'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    match /restocks/{id} {
      allow read: if isStaff();
      allow create: if isOwner() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------- transactions ----------------
    // Append-only ledger. A sale can only be created for a table whose clock was stopped by the server,
    // with the table fee recomputed from that session's server stamps, in the same write that frees the table.
    // A Quick Sale (walk-in, no table) instead just has to add up: no table fee, total == productTotal.
    function quickSaleOk(sale) {
      return sale.tableId == null
        && sale.tableFee == 0
        && sale.items is list
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - sale.productTotal) < 0.005;
    }

    function saleMatchesSession(sale, id) {
      let before = get(tablePath(sale.tableId)).data;
      let after = getAfter(tablePath(sale.tableId)).data;
      return before.status == 'in_use' && before.session != null
        && before.session.ended == true && before.session.endedAt is timestamp
        && sale.startedAt.toMillis() == before.session.startedAt.toMillis()
        && sale.endedAt.toMillis() == before.session.endedAt.toMillis()
        && sale.durationMs == before.session.endedAt.toMillis() - before.session.startedAt.toMillis()
        && sale.plannedMs == before.session.plannedMs
        && billedOk(sale.billedMs, sale.durationMs, sale.plannedMs)
        && feeOk(sale.tableFee, sale.billedMs)
        && sale.productTotal is number && sale.productTotal >= 0
        && math.abs(sale.total - (sale.tableFee + sale.productTotal)) < 0.005
        && after.status == 'available' && after.session == null && after.lastTxId == id;
    }

    // A table-fee void waives only the table charge and refunds it through whichever payment channel
    // covered it; items, their stock, and the table itself are never touched. It's allowed once, only
    // by the cashier who rang the sale or the owner, and only when the table was used
    // VOID_ELIGIBLE_DURATION_MS (5 minutes, mirrors js/billing.js) or less — a real-time deadline would
    // be pointless here since the eligibility itself never changes after checkout.
    function tableFeeVoidOk() {
      let before = resource.data;
      let after = request.resource.data;
      let refund = before.tableFee;
      return before.get('tableFeeVoided', false) != true
        && before.durationMs <= 300000
        && after.tableFeeVoided == true
        && after.tableFeeVoidedById == request.auth.uid
        && after.tableFeeVoidedAt == request.time
        && refund is number && refund > 0
        && after.originalTableFee == before.tableFee
        && after.originalTotal == before.total
        && after.tableFee == 0
        && math.abs(after.total - before.productTotal) < 0.005
        && after.refundAmount is number && math.abs(after.refundAmount - refund) < 0.005
        && after.refundMethod in ['cash', 'gcash']
        && after.payments.cash is number && after.payments.gcash is number
        && (
          (after.refundMethod == 'cash'
            && math.abs(after.payments.cash - (before.payments.cash - refund)) < 0.005
            && after.payments.gcash == before.payments.gcash)
          || (after.refundMethod == 'gcash'
            && math.abs(after.payments.gcash - (before.payments.gcash - refund)) < 0.005
            && after.payments.cash == before.payments.cash)
        )
        && after.payments.cash >= -0.005 && after.payments.gcash >= -0.005
        && onlyChanges(['tableFeeVoided', 'tableFeeVoidedAt', 'tableFeeVoidedById', 'tableFeeVoidedByName',
             'voidReason', 'voidNote', 'originalTableFee', 'originalTotal', 'tableFee', 'total',
             'payments', 'refundAmount', 'refundMethod']);
    }

    match /transactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.method in ['cash', 'gcash', 'split']
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.tableId == null && quickSaleOk(request.resource.data))
            || (request.resource.data.tableId != null && saleMatchesSession(request.resource.data, id)));
      allow update: if isStaff()
        && (isOwner() || resource.data.cashierId == request.auth.uid)
        && tableFeeVoidOk();
      allow delete: if false;
    }

    // Hall-wide settings (e.g. settings/shifts: whether the hall runs one shift or Day + Night).
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ---------------- expenses ----------------
    // Cash taken from the drawer. Any staff member logs expenses under their own name, stamped with
    // server time so each one lands on the shift that was actually on duty. Nobody can edit a logged
    // expense. Only the owner can remove a mistaken one, so the shift report stays an audit trail.
    match /expenses/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['description', 'amount', 'cashierId', 'cashierName', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.cashierName is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
