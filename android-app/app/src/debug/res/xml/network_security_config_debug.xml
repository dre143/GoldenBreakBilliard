<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build-only: lets the emulator/adb-reverse loopback hosts load over
     plain HTTP for local dev-server testing. Never packaged into a release
     build (src/debug source set), and does not loosen anything for the real
     app_url domain, which stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
